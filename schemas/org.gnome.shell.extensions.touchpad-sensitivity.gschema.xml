<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.touchpad-sensitivity" path="/org/gnome/shell/extensions/touchpad-sensitivity/">
    <key name="scroll-factor" type="d">
      <default>1.0</default>
      <range min="0.1" max="3.0"/>
      <summary>Touchpad scroll multiplier</summary>
      <description>Values below 1 slow scrolling; values above 1 speed it up. Applies to both axes.</description>
    </key>
  </schema>
</schemalist>
